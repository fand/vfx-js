{
  "name": "@vfx-js/storybook",
  "private": true,
  "version": "0.0.25",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "pnpm run build-storybook",
    "build-storybook": "storybook build -o docs-build",
    "clean": "rm -rf docs-build",
    "lint": "biome check src .storybook",
    "format": "biome check --write src .storybook"
  },
  "dependencies": {
    "@vfx-js/core": "workspace:*",
    "@vfx-js/effects": "workspace:*",
    "@vfx-js/react": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@chromatic-com/storybook": "5.6.0",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/html-vite": "10.6.4",
    "@tweakpane/core": "2.0.5",
    "@types/node": "26.6.5",
    "storybook": "10.6.4",
    "tweakpane": "4.0.5"
  },
  "overrides": {
    "storybook": "$storybook"
  }
}
