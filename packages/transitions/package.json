{
  "name": "@vfx-js/transitions",
  "description": "Page transition presets for @vfx-js/core",
  "version": "0.0.0",
  "files": [
    "package.json",
    "README.md",
    "lib/"
  ],
  "type": "module",
  "main": "./lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      },
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      }
    }
  },
  "scripts": {
    "build": "run-s clean build:cjs build:esm build:dual",
    "build:cjs": "tsc -d -p tsconfig.build.json",
    "build:esm": "tsc -d -p tsconfig.esm.json",
    "build:dual": "tsconfig-to-dual-package",
    "clean": "rimraf lib",
    "dev": "run-p watch:cjs watch:esm",
    "watch:cjs": "tsc -d -w -p tsconfig.build.json",
    "watch:esm": "tsc -d -w -p tsconfig.esm.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest --dir src --run",
    "lint-staged": "lint-staged"
  },
  "peerDependencies": {
    "@vfx-js/core": ">=1.4.0"
  },
  "dependencies": {
    "@vfx-js/effects": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@vfx-js/core": "workspace:*",
    "gl-transitions": "2.0.0",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "rimraf": "^6.1.3",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "src/*.ts": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "author": "Takayosi Amagi <fand.gmork@gmail.com> (https://amagi.dev/)",
  "homepage": "https://amagi.dev/vfx-js",
  "repository": {
    "url": "https://github.com/fand/vfx-js"
  },
  "bugs": {
    "url": "https://github.com/fand/vfx-js/issues"
  },
  "keywords": [
    "glsl",
    "webgl",
    "webgl2",
    "transitions"
  ],
  "license": "MIT"
}
