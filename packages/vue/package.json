{
  "name": "@vfx-js/vue",
  "description": "WebGL page transitions for Vue and Nuxt",
  "version": "0.3.0",
  "files": [
    "package.json",
    "README.md",
    "lib/"
  ],
  "type": "module",
  "main": "./lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      },
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      }
    },
    "./nuxt": {
      "require": {
        "types": "./lib/cjs/nuxt/index.d.ts",
        "default": "./lib/cjs/nuxt/index.js"
      },
      "import": {
        "types": "./lib/esm/nuxt/index.d.ts",
        "default": "./lib/esm/nuxt/index.js"
      }
    },
    "./router": {
      "require": {
        "types": "./lib/cjs/router/index.d.ts",
        "default": "./lib/cjs/router/index.js"
      },
      "import": {
        "types": "./lib/esm/router/index.d.ts",
        "default": "./lib/esm/router/index.js"
      }
    }
  },
  "scripts": {
    "build": "run-s clean build:cjs build:esm build:dual",
    "build:cjs": "tsc -d -p tsconfig.build.json",
    "build:esm": "tsc -d -p tsconfig.esm.json",
    "build:dual": "tsconfig-to-dual-package",
    "clean": "rimraf lib",
    "dev": "run-p watch:cjs watch:esm",
    "watch:cjs": "tsc -d -w -p tsconfig.build.json",
    "watch:esm": "tsc -d -w -p tsconfig.esm.json",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "lint-staged": "lint-staged",
    "test": "vitest --dir src --run",
    "test:watch": "vitest --dir src"
  },
  "peerDependencies": {
    "@vfx-js/core": "workspace:^",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@vfx-js/core": "workspace:*",
    "happy-dom": "21.0.4",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "rimraf": "^6.1.3",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "author": "Takayosi Amagi <fand.gmork@gmail.com> (https://amagi.dev/)",
  "homepage": "https://amagi.dev/vfx-js",
  "repository": {
    "url": "https://github.com/fand/vfx-js"
  },
  "bugs": {
    "url": "https://github.com/fand/vfx-js/issues"
  },
  "keywords": [
    "glsl",
    "nuxt",
    "transition",
    "vue",
    "webgl"
  ],
  "license": "MIT"
}
