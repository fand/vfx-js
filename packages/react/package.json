{
  "name": "@vfx-js/react",
  "description": "WebGL effects for React elements",
  "version": "1.5.0",
  "files": [
    "package.json",
    "README.md",
    "lib/"
  ],
  "type": "module",
  "main": "./lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      },
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      }
    },
    "./next": {
      "require": {
        "types": "./lib/cjs/next/index.d.ts",
        "default": "./lib/cjs/next/index.js"
      },
      "import": {
        "types": "./lib/esm/next/index.d.ts",
        "default": "./lib/esm/next/index.js"
      }
    },
    "./react-router": {
      "require": {
        "types": "./lib/cjs/react-router/index.d.ts",
        "default": "./lib/cjs/react-router/index.js"
      },
      "import": {
        "types": "./lib/esm/react-router/index.d.ts",
        "default": "./lib/esm/react-router/index.js"
      }
    }
  },
  "scripts": {
    "build": "run-s clean build:cjs build:esm build:dual",
    "build:cjs": "tsc -d -p tsconfig.build.json",
    "build:esm": "tsc -d -p tsconfig.esm.json",
    "build:dual": "tsconfig-to-dual-package",
    "clean": "rimraf lib",
    "dev": "run-p watch:cjs watch:esm",
    "watch:cjs": "tsc -d -w -p tsconfig.build.json",
    "watch:esm": "tsc -d -w -p tsconfig.esm.json",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "lint-staged": "lint-staged",
    "test": "vitest --dir src --run",
    "test:watch": "vitest --dir src"
  },
  "peerDependencies": {
    "@vfx-js/core": "workspace:^",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vfx-js/core": "workspace:*",
    "happy-dom": "21.0.4",
    "lint-staged": "^17.6.0",
    "next": "16.4.3",
    "npm-run-all2": "^9.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "rimraf": "^6.1.3",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "src/*.{ts,tsx}": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "author": "Takayosi Amagi <fand.gmork@gmail.com> (https://amagi.dev/)",
  "homepage": "https://amagi.dev/vfx-js",
  "repository": {
    "url": "https://github.com/fand/vfx-js"
  },
  "bugs": {
    "url": "https://github.com/fand/vfx-js/issues"
  },
  "keywords": [
    "glsl",
    "react",
    "threejs",
    "webgl"
  ],
  "license": "MIT"
}
