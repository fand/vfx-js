{
    "root": false,
    "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
    "extends": ["../../biome.json"],
    "files": {
        "includes": ["**/src/**/*.ts"]
    },
    "overrides": [
        {
            "includes": ["**/*.test.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noAssignInExpressions": "off",
                        "useIterableCallbackReturn": "off"
                    }
                }
            }
        }
    ]
}
