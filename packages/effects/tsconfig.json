{
    "compilerOptions": {
        "target": "es2022",
        "module": "CommonJS",
        "lib": ["es2022", "dom"],
        "sourceMap": true,
        "outDir": "lib/cjs",
        "rootDir": "src",
        "ignoreDeprecations": "6.0",
        "removeComments": false,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "moduleResolution": "node",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowJs": true
    },
    "include": ["src"],
    // _sphere-foam.ts is the shader's maths in TypeScript, for the tests only.
    "exclude": ["src/**/*.test.ts", "src/_sphere-foam.ts"]
}
