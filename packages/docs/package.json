{
  "name": "docs",
  "private": true,
  "version": "0.0.25",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm-run-all -p build:storybook build:examples build:tsc -s build:docs build:storybook-dist build:examples-dist build:llms",
    "build:tsc": "astro check",
    "build:storybook": "rm -rf storybook && cp -a ../storybook/docs-build storybook",
    "build:examples": "rm -rf examples && cp -a ../examples/docs-build examples",
    "build:docs": "astro build",
    "build:storybook-dist": "rm -rf dist/storybook && cp -a storybook dist/storybook",
    "build:examples-dist": "rm -rf dist/examples && cp -a examples dist/examples",
    "build:llms": "node scripts/build-llms-full.mjs",
    "test": "node scripts/check-skill.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "preview": "astro preview",
    "clean": "rimraf dist storybook examples"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@vfx-js/astro": "workspace:*",
    "@vfx-js/core": "workspace:*",
    "@vfx-js/effects": "workspace:*",
    "@vfx-js/examples": "workspace:*",
    "@vfx-js/storybook": "workspace:*",
    "@vfx-js/transitions": "workspace:*",
    "astro": "^7.4.2",
    "markdown-it": "14.3.3",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "26.6.5",
    "npm-run-all2": "^9.0.4",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3"
  }
}
