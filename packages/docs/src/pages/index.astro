---
import PageCards from "../components/PageCards.astro";
import Layout from "../layouts/Layout.astro";
import { nav, url } from "../site";
import "../styles/top.css";
---

<Layout class="Top">
    <!-- Old single-page anchors now live on their own pages. Replace, so Back skips the old URL. -->
    <script is:inline define:vars={{ base: url() }}>
        const pages = {
            "#examples": "effects/",
            "#custom": "shaders/",
            "#multipass": "shaders/#multipass",
            "#effect-bloom": "effects/#gallery",
            "#effect-crt": "effects/#gallery",
        };
        const to = pages[location.hash];
        if (to) {
            location.replace(base + to);
        }
    </script>
    <noscript>You need to enable JavaScript to run this app.</noscript>

    <section class="Hero">
        <div class="HeroMain">
            <img id="Logo" src={url("vfx-js-logo-no-padding.svg")} alt="VFX-JS" />
            <p id="LogoTagline" class="HeroTagline">
                WebGL effects for HTML.
            </p>
        </div>

        <div class="EffectMenu">
            <p class="EffectMenuTitle">TRY AN EFFECT</p>
            <ol class="EffectList"></ol>
            <label class="EffectIntensity">
                <span>INTENSITY</span>
                <input
                    class="EffectSlider"
                    type="range"
                    min="0"
                    max="1"
                    step="0.01"
                    value="0.6"
                />
            </label>
            <button class="EffectCopy" type="button">Copy code &#8599;</button>
        </div>

        <div class="HeroFoot">
            <span>SCROLL TO EXPLORE &#8595;</span>
            <span>@vfx-js/effects</span>
        </div>
    </section>

    <section class="TopCards" aria-label="Docs">
        <PageCards
            items={nav.map((item) => ({
                href: url(`${item.slug}/`),
                label: item.label,
                blurb: item.blurb,
            }))}
        />
    </section>

    <Fragment slot="overlay">
        <div id="MaskBottom"></div>
        <div id="MaskTop"></div>
    </Fragment>
</Layout>

<script>
    import "../main.ts";
</script>
