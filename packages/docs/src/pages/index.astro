---
import Layout from "../layouts/Layout.astro";
import { nav, url } from "../site";
import "../styles/top.css";
---

<Layout class="Top">
    <noscript>You need to enable JavaScript to run this app.</noscript>

    <section class="Hero">
        <div class="HeroMain">
            <img id="Logo" src={url("vfx-js-logo-no-padding.svg")} alt="VFX-JS" />
            <p id="LogoTagline" class="HeroTagline">
                WebGL effects for HTML.
            </p>
        </div>

        <div class="EffectMenu">
            <p class="EffectMenuTitle">TRY AN EFFECT</p>
            <ol class="EffectList"></ol>
            <label class="EffectIntensity">
                <span>INTENSITY</span>
                <input
                    class="EffectSlider"
                    type="range"
                    min="0"
                    max="1"
                    step="0.01"
                    value="0.6"
                />
            </label>
            <button class="EffectCopy" type="button">Copy code &#8599;</button>
        </div>

        <div class="HeroFoot">
            <span>SCROLL TO EXPLORE &#8595;</span>
            <span>@vfx-js/effects</span>
        </div>
    </section>

    <section class="PageCards" aria-label="Docs">
        {
            nav.map((item, i) => (
                <a class="PageCard" href={url(`${item.slug}/`)}>
                    <span class="PageCardNum">
                        {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="PageCardTitle">{item.label}</span>
                    <span class="PageCardBlurb">{item.blurb}</span>
                    <span class="PageCardArrow" aria-hidden="true">
                        &#8594;
                    </span>
                </a>
            ))
        }
    </section>

    <Fragment slot="overlay">
        <div id="MaskBottom"></div>
        <div id="MaskTop"></div>
    </Fragment>
</Layout>

<script>
    import "../main.ts";
</script>
