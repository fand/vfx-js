---
import { links, nav, url } from "../site";

type Props = {
    current?: string;
};

const { current } = Astro.props;
---

<header class="SiteHeader">
    <a class="SiteHeaderBrand" href={url()}>
        <img src={url("vfx-js-logo-no-padding.svg")} alt="VFX-JS" />
    </a>
    <button
        class="SiteHeaderMenuButton"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="SiteHeaderNav"
    >
        <span aria-hidden="true"></span>
    </button>
    <nav id="SiteHeaderNav" class="SiteHeaderNav">
        {
            nav.map((item) => (
                <a
                    class:list={{ SiteHeaderMenuOnly: !item.headerLabel }}
                    href={url(`${item.slug}/`)}
                    aria-current={item.slug === current ? "page" : undefined}
                >
                    {item.headerLabel ?? item.label}
                </a>
            ))
        }
        <a href={url("docs/")}>API</a>
        <a href={links.github} target="_blank" rel="noreferrer">
            GitHub &#8599;
        </a>
    </nav>
</header>

<script>
    import { onPage } from "../lifecycle";

    const setOpen = (open: boolean) => {
        const header = document.querySelector<HTMLElement>(".SiteHeader");
        header?.setAttribute("data-open", String(open));
        header
            ?.querySelector(".SiteHeaderMenuButton")
            ?.setAttribute("aria-expanded", String(open));
    };

    // Page swaps replace the header, so bind the button on every page.
    onPage(() => {
        const header = document.querySelector<HTMLElement>(".SiteHeader");
        header
            ?.querySelector(".SiteHeaderMenuButton")
            ?.addEventListener("click", () => {
                setOpen(header.dataset.open !== "true");
            });
    });

    window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            setOpen(false);
        }
    });
</script>
