---
import { links, nav, url } from "../site";

type Props = {
    current?: string;
};

const { current } = Astro.props;
---

<header class="SiteHeader">
    <a class="SiteHeaderBrand" href={url()}>
        <img src={url("vfx-js-logo-no-padding.svg")} alt="VFX-JS" />
    </a>
    <button
        class="SiteHeaderMenuButton"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="SiteHeaderNav"
    >
        <span aria-hidden="true"></span>
    </button>
    <nav id="SiteHeaderNav" class="SiteHeaderNav">
        {
            nav.map((item) => (
                <a
                    class:list={{ SiteHeaderMenuOnly: !item.headerLabel }}
                    href={url(`${item.slug}/`)}
                    aria-current={item.slug === current ? "page" : undefined}
                >
                    {item.headerLabel ?? item.label}
                </a>
            ))
        }
        <a href={url("docs/")}>API</a>
        <a href={links.github} target="_blank" rel="noreferrer">
            GitHub &#8599;
        </a>
    </nav>
</header>

<script>
    const header = document.querySelector(".SiteHeader") as HTMLElement;
    const button = header.querySelector(
        ".SiteHeaderMenuButton",
    ) as HTMLButtonElement;

    const setOpen = (open: boolean) => {
        header.dataset.open = String(open);
        button.setAttribute("aria-expanded", String(open));
    };
    button.addEventListener("click", () => {
        setOpen(header.dataset.open !== "true");
    });
    window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            setOpen(false);
        }
    });

    // Clip the page at the header's bottom edge, so only the BG shows behind the header.
    const page = document.querySelector(".Page") as HTMLElement;
    const loop = () => {
        const edge = header.getBoundingClientRect().bottom;
        const top = Math.max(0, edge - page.getBoundingClientRect().top);
        page.style.clipPath = `inset(${top}px 0 0 0)`;
        requestAnimationFrame(loop);
    };
    loop();
</script>
