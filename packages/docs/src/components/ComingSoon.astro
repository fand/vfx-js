---
import { findNav } from "../site";

type Props = {
    page: string;
};

const item = findNav(Astro.props.page);
---

<h1>{item.label}</h1>
<p>Coming soon.</p>
{
    item.sections.map((section) => (
        <section id={section.id}>
            <h2>{section.label}</h2>
            <p>Coming soon.</p>
        </section>
    ))
}
