---
export type PageCardItem = {
    href: string;
    label: string;
    blurb: string;
};

type Props = {
    items: PageCardItem[];
};

const { items } = Astro.props;
---

<div class="PageCards">
    {
        items.map((item, i) => (
            <a class="PageCard" href={item.href}>
                <span class="PageCardNum">
                    {String(i + 1).padStart(2, "0")}
                </span>
                <span class="PageCardTitle">{item.label}</span>
                <span class="PageCardBlurb">{item.blurb}</span>
                <span class="PageCardArrow" aria-hidden="true">
                    &#8594;
                </span>
            </a>
        ))
    }
</div>

<style>
    .PageCards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }
    .PageCard {
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr) auto;
        align-content: start;
        column-gap: 8px;
        row-gap: 12px;
        padding: 24px;
        border-radius: 4px;
        background: rgba(0, 0, 0, 0.8);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
        text-decoration: none;
        transition: background 0.2s;
    }
    .PageCard:hover {
        background: rgba(255, 255, 255, 0.1);
    }
    .PageCardNum {
        font-family: var(--mono);
        font-size: 14px;
        line-height: 26px;
        color: rgba(255, 255, 255, 0.35);
    }
    .PageCardTitle {
        font-family: "Helvetica Neue", Arial, sans-serif;
        font-size: 22px;
        font-weight: 600;
    }
    .PageCardArrow {
        grid-column: 3;
        grid-row: 1;
        font-size: 20px;
        transition: transform 0.2s;
    }
    .PageCard:hover .PageCardArrow {
        transform: translateX(4px);
    }
    .PageCardBlurb {
        grid-column: 2 / 4;
        grid-row: 2;
        font-size: 15px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.7);
    }

    @media (max-width: 1023px) {
        .PageCards {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @media (max-width: 767px) {
        .PageCards {
            grid-template-columns: minmax(0, 1fr);
        }
        .PageCard {
            grid-template-columns: 40px minmax(0, 1fr) auto;
            padding: 20px;
        }
    }
</style>
