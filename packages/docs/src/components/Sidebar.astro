---
import { loadApi } from "../api/model";
import { nav, url } from "../site";

type Props = {
    current: string;
};

const { current } = Astro.props;

// API pages list the packages and their declarations.
const apiPath = Astro.url.pathname.replace(url(), "");
const api = current === "docs" ? loadApi() : undefined;
---

<nav class="DocSidebar" aria-label="Docs">
    <ul>
        {
            nav.map((item) => (
                <li>
                    <a
                        href={url(`${item.slug}/`)}
                        aria-current={item.slug === current ? "page" : undefined}
                    >
                        {item.label}
                    </a>
                    {item.slug === current && api && (
                        <div class="DocSidebarApi">
                            {api.packages.map((pkg) => (
                                <div>
                                    <a
                                        class="DocSidebarPackage"
                                        href={url(`docs/#${pkg.slug}`)}
                                    >
                                        {pkg.name}
                                    </a>
                                    {pkg.groups.map((group) => (
                                        <details
                                            open={
                                                group.pages.some(
                                                    (p) => p.path === apiPath,
                                                ) || undefined
                                            }
                                        >
                                            <summary>
                                                {group.title}
                                                <span>{group.pages.length}</span>
                                            </summary>
                                            <ul>
                                                {group.pages.map((p) => (
                                                    <li>
                                                        <a
                                                            href={url(p.path)}
                                                            aria-current={
                                                                p.path === apiPath
                                                                    ? "page"
                                                                    : undefined
                                                            }
                                                        >
                                                            {p.decl.name}
                                                        </a>
                                                    </li>
                                                ))}
                                            </ul>
                                        </details>
                                    ))}
                                </div>
                            ))}
                        </div>
                    )}
                    {item.slug === current && item.sections.length > 0 && (
                        <ul>
                            {item.sections.map((section) => (
                                <li>
                                    <a
                                        href={`#${section.id}`}
                                        data-section={section.id}
                                    >
                                        {section.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    )}
                </li>
            ))
        }
    </ul>
    <a
        class="DocSidebarExtra"
        href={url("examples/")}
        target="_blank"
        rel="noreferrer">Examples &#8599;</a
    >
</nav>

<script>
    import { onPage, scrollRoot } from "../lifecycle";

    // Mark the section that crossed the upper third of the viewport last.
    onPage(() => {
        const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>(
                ".DocSidebar [data-section]",
            ),
        );
        const root = scrollRoot();
        if (links.length === 0 || !root) {
            return;
        }
        const targets = links.map((link) =>
            document.getElementById(link.dataset.section ?? ""),
        );

        const update = () => {
            const line = window.innerHeight / 3;
            let active = 0;
            for (const [i, target] of targets.entries()) {
                if (target && target.getBoundingClientRect().top < line) {
                    active = i;
                }
            }
            for (const [i, link] of links.entries()) {
                link.classList.toggle("active", i === active);
            }
        };

        root.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
        return () => window.removeEventListener("resize", update);
    });
</script>
